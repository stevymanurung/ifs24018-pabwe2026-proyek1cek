{
  "name": "ifs24018-pabwe2026-proyek1-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API Study Planner (Express.js + SQLite)",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "test": "node --test",
    "test:ci": "node --test --test-reporter=junit",
    "test:v1": "node --test evidence/run-v1-api.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
