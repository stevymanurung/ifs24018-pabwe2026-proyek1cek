# Konfigurasi server (Node.js membaca environment variable; contoh: `node src/index.js`)
PORT=3001
DB_FILE=./data/planner.db
# Isi "true" untuk memasukkan data contoh saat database masih kosong
SEED_DEMO=false
# Hanya jika front-end di-host di domain lain (di pengembangan tidak perlu: Vite memakai proxy)
CORS_ORIGIN=
# Lokasi hasil build front-end yang disajikan Express (bawaan: ../client/dist)
CLIENT_DIST=
